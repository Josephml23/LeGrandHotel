// LeGrandHotel — diagrama editable de la base de datos (MySQL 8 en Amazon RDS).
// Pégalo en https://dbdiagram.io y exporta a PNG/PDF para el informe.
// Fuente de verdad: api/database/migrations/

Project LeGrandHotel {
  database_type: 'MySQL'
  Note: 'Sistema web de gestión de hospedaje · TECSUP · Desarrollo de Soluciones en la Nube'
}

Table users {
  id bigint [pk, increment]
  name varchar
  email varchar [unique]
  password varchar [null, note: 'bcrypt (cast hashed); null en cuentas de Google']
  google_id varchar [null, unique]
  email_verified_at timestamp [null]
  remember_token varchar [null]
  created_at timestamp
  updated_at timestamp
}

Table roles {
  id bigint [pk, increment]
  name varchar [unique, note: 'admin, receptionist, storekeeper, client']
  label varchar
}

Table role_user {
  user_id bigint [ref: > users.id]
  role_id bigint [ref: > roles.id]
  indexes { (user_id, role_id) [pk] }
}

Table clients {
  id bigint [pk, increment]
  user_id bigint [null, unique, ref: - users.id]
  document_type varchar
  document_number varchar [unique]
  full_name varchar
  phone varchar [null]
  nationality varchar [null]
  created_at timestamp
  indexes { full_name }
}

Table staff {
  id bigint [pk, increment]
  user_id bigint [unique, ref: - users.id]
  position varchar
  shift varchar [note: 'morning, afternoon, night']
  hired_at date
}

Table room_types {
  id bigint [pk, increment]
  name varchar [unique]
  description text [null]
  capacity smallint
  price_per_night decimal(10,2)
}

Table rooms {
  id bigint [pk, increment]
  room_type_id bigint [ref: > room_types.id]
  number varchar [unique]
  floor smallint
  status varchar [note: 'available, occupied, cleaning, maintenance']
  indexes { status }
}

Table reservations {
  id bigint [pk, increment]
  client_id bigint [ref: > clients.id]
  room_id bigint [ref: > rooms.id]
  check_in date
  check_out date
  guests smallint
  status varchar [note: 'pending, confirmed, checked_in, completed, cancelled']
  total decimal(10,2) [note: 'noches × precio por noche, calculado en el servidor']
  notes text [null]
  indexes {
    (check_in, check_out)
    client_id
    (room_id, status)
  }
}

Table stays {
  id bigint [pk, increment]
  reservation_id bigint [unique, ref: - reservations.id]
  checked_in_at timestamp
  checked_out_at timestamp [null]
}

Table parking_spots {
  id bigint [pk, increment]
  code varchar [unique]
  status varchar [note: 'free, occupied, maintenance']
  indexes { status }
}

Table parking_assignments {
  id bigint [pk, increment]
  parking_spot_id bigint [ref: > parking_spots.id]
  stay_id bigint [null, ref: > stays.id]
  plate varchar
  entered_at timestamp
  left_at timestamp [null]
  indexes { plate }
}

Table inventory_items {
  id bigint [pk, increment]
  name varchar
  unit varchar
  stock int
  min_stock int
  indexes { name }
}

Table inventory_movements {
  id bigint [pk, increment]
  inventory_item_id bigint [ref: > inventory_items.id]
  user_id bigint [null, ref: > users.id]
  type varchar [note: 'in, out']
  quantity int
  reason varchar [null]
  created_at timestamp
}

Table audit_logs {
  id bigint [pk, increment]
  user_id bigint [null, ref: > users.id]
  action varchar [note: 'created, updated, deleted']
  entity varchar
  entity_id bigint [null]
  changes json [null]
  ip varchar [null]
  created_at timestamp
  indexes { (entity, entity_id) }
}

Table personal_access_tokens {
  id bigint [pk, increment]
  tokenable_id bigint [ref: > users.id]
  name varchar
  token varchar(64) [unique]
  expires_at timestamp [null, note: 'Sanctum: 60 minutos']
}
