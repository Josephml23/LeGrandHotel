@startuml LeGrandHotel
' UML class diagram of the LeGrandHotel domain (Laravel models in api/app/Models).
' Open it at https://www.plantuml.com/plantuml or with the PlantUML extension for VS Code.
' role_user is the join table of the many-to-many association User — Role.

!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
hide circle

title LeGrandHotel — Class diagram (staff and guest accounts)

class User {
  + id: int
  + name: string
  + email: string {unique}
  - password: string {bcrypt}
  + google_id: string [0..1]
  + email_verified_at: datetime [0..1]
  --
  + hasRole(roles: string...): bool
  + assignRole(name: string): void
  + isAdmin(): bool
}

class Role {
  + id: int
  + name: string {unique}
  + label: string
  --
  {static} ADMIN, RECEPTIONIST,
  {static} STOREKEEPER, DEVELOPER, CLIENT
}

class Staff {
  + id: int
  + position: string
  + shift: string
  + hired_at: date
}

class Client <<guest>> {
  + id: int
  + document_type: string
  + document_number: string {unique}
  + full_name: string
  + phone: string [0..1]
  + nationality: string [0..1]
}

class RoomType {
  + id: int
  + name: string {unique}
  + amenities: json [0..1]
  + capacity: int
  + price_per_night: decimal
}

class Room {
  + id: int
  + number: string {unique}
  + floor: int
  + status: string
  --
  + availableBetween(from, to): Query
}

class Reservation {
  + id: int
  + check_in: date
  + check_out: date
  + guests: int
  + status: string
  + total: decimal
  --
  + overlapping(from, to): Query
}

class Stay {
  + id: int
  + checked_in_at: datetime
  + checked_out_at: datetime [0..1]
}

class ParkingSpot {
  + id: int
  + code: string {unique}
  + status: string
}

class ParkingAssignment {
  + id: int
  + plate: string
  + entered_at: datetime
  + left_at: datetime [0..1]
}

class InventoryItem {
  + id: int
  + name: string
  + unit: string
  + stock: int
  + min_stock: int
  --
  + isBelowMinimum(): bool
}

class InventoryMovement {
  + id: int
  + type: string {in | out}
  + quantity: int
  + reason: string [0..1]
}

class AuditLog {
  + id: int
  + action: string {created | updated | deleted}
  + entity: string
  + entity_id: int
  + changes: json [0..1]
  + created_at: datetime
}

User "0..*" -- "1..*" Role : has >
User "1" -- "0..1" Staff : staff record >
User "0..1" -- "0..1" Client : guest account >
User "0..1" -- "0..*" AuditLog : performs >
User "0..1" -- "0..*" InventoryMovement : records >
Client "1" -- "0..*" Reservation : books >
RoomType "1" -- "0..*" Room : classifies >
Room "1" -- "0..*" Reservation : is booked in >
Reservation "1" -- "0..1" Stay : creates >
Stay "0..1" -- "0..*" ParkingAssignment : uses >
ParkingSpot "1" -- "0..*" ParkingAssignment : occupies >
InventoryItem "1" -- "0..*" InventoryMovement : moves >

@enduml
