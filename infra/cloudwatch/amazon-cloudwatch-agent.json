{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/docker/volumes/legrandhotel_api-logs/_data/laravel.json",
            "log_group_name": "/legrandhotel/api",
            "log_stream_name": "{instance_id}/api",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/legrandhotel-backup.log",
            "log_group_name": "/legrandhotel/api",
            "log_stream_name": "{instance_id}/backup",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "LeGrandHotel",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  }
}
