# LeGrandHotel API — copia este archivo a .env (nunca subas .env a Git).
# Los valores por defecto sirven para docker-compose. En AWS los secretos viven en SSM Parameter Store.

APP_NAME=LeGrandHotel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_TIMEZONE=America/Lima
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Dominio del frontend: CORS y redirecciones (varios separados por coma).
FRONTEND_URL=http://localhost:5173

# Logs: stack para errores + canal json (una línea por petición) que lee CloudWatch.
LOG_CHANNEL=stack
LOG_STACK=single,json
LOG_REQUEST_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=legrandhotel
DB_USERNAME=legrandhotel
DB_PASSWORD=
# Timeout de conexión a la BD en segundos (caída controlada → 503).
DB_TIMEOUT=3

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum: los tokens vencen a los 60 minutos.
SANCTUM_EXPIRATION=60

# Rate limits por minuto (subirlos solo en el entorno de pruebas de carga).
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_API=60

# Login con Google (Google Cloud Console → Credenciales OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@legrandhotel.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Contraseña de las cuentas de demostración del DemoSeeder (solo desarrollo).
DEMO_PASSWORD=LeGrand2026
