# syntax=docker/dockerfile:1.7
# Imagen de la API para Render: UN solo contenedor con Nginx + PHP-FPM escuchando en $PORT.
# En AWS se usa api/Dockerfile (solo PHP-FPM) con un Nginx aparte; Render da un contenedor por servicio,
# así que aquí los dos procesos viven juntos. Incluye pdo_pgsql porque Render administra PostgreSQL.

FROM composer:2.8 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-req=ext-redis
COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

FROM php:8.3-fpm-alpine AS runtime

RUN apk add --no-cache icu-libs libzip libpq nginx \
 && apk add --no-cache --virtual .build $PHPIZE_DEPS icu-dev libzip-dev postgresql-dev linux-headers \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql pdo_pgsql bcmath intl opcache pcntl zip \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && apk del .build

COPY --from=vendor /app /var/www/html
COPY docker/php.ini /usr/local/etc/php/conf.d/zz-legrandhotel.ini
COPY docker/render/php.ini /usr/local/etc/php/conf.d/zzz-render.ini
COPY docker/render/fpm.conf /usr/local/etc/php-fpm.render.conf
COPY docker/render/nginx.conf /etc/nginx/nginx.conf.template
COPY docker/render/start.sh /usr/local/bin/start

WORKDIR /var/www/html
RUN chmod +x /usr/local/bin/start \
 && chown -R www-data:www-data storage bootstrap/cache \
 && rm -f .env

USER www-data
# Render entrega el puerto en $PORT; 10000 es su valor por defecto.
EXPOSE 10000
CMD ["start"]
